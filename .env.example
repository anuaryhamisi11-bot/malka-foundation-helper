# ---------------------------------------------------------------------------
# MALKA FOUNDATION HELPER - Environment variables
# Copy this file to ".env" for local development.
# In Netlify, add every one of these under Site settings -> Environment variables.
# Never commit the real ".env" file to git.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Use a serverless-friendly Postgres host
# (Neon.tech or Supabase both work well with Netlify Functions).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Long random secret used to sign login session tokens (JWT).
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# ---- File storage (required for the Documents module) ---------------------
# Any S3-compatible provider works: AWS S3, Cloudflare R2, Backblaze B2,
# Supabase Storage (S3 mode), DigitalOcean Spaces.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- AI Assistant (Admin only) --------------------------------------------
# Any OpenAI-compatible Chat Completions endpoint works.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ---- Video meetings (optional) --------------------------------------------
# If set, meeting rooms are created automatically through the Daily.co API
# (a real hosted WebRTC provider). If left blank, the scheduler can paste
# any external meeting link (Zoom, Google Meet, etc.) instead.
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1
